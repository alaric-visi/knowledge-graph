# Copy to .env and adjust.

# Absolute path to your Obsidian vault on the host machine.
VAULT_HOST_PATH=/Users/yourname/Documents/MyVault

# Model to use — must be pulled into Ollama first.
OLLAMA_MODEL=qwen3.5:9b

# Embedding model for search — must be pulled into Ollama first.
OLLAMA_EMBED_MODEL=bge-large

# Let thinking models reason before answering. Much slower (minutes per run).
OLLAMA_THINK=false

# Ollama API base URL (container-internal default; change for remote Ollama).
OLLAMA_URL=http://ollama:11434

# Without local models: chat with hosted Ollama directly. The key is sent as a
# bearer token to OLLAMA_URL only. Direct calls take the model's plain name
# (OLLAMA_MODEL=gpt-oss:120b), not the app's "-cloud" name.
# OLLAMA_URL=https://ollama.com
# OLLAMA_API_KEY=

# Embeddings go to OLLAMA_URL, with OLLAMA_API_KEY, unless OLLAMA_EMBED_URL
# names another endpoint; then only OLLAMA_EMBED_API_KEY is sent there. Keep
# embeddings on a local Ollama (bge-large runs fine on a CPU) when chat is in
# the cloud. Inside compose, the local one is http://ollama:11434.
# OLLAMA_EMBED_URL=http://ollama:11434
# OLLAMA_EMBED_API_KEY=

# Port the webhook service listens on. docker compose publishes it on the
# host's loopback only (127.0.0.1), so nobody else on the network can reach it.
PORT=5678

# Address the service listens on when run directly (npm start / npm run dev).
# Loopback by default; set 0.0.0.0 only if you really want it on the network.
# The Docker image sets this to 0.0.0.0 inside the container itself; publish
# its port on loopback (compose does; with docker run, -p 127.0.0.1:5678:5678).
HOST=127.0.0.1

# Also write a best-practices research note for every code capture. Off by
# default: the graph holds your own work, and runs take about half the time.
RESEARCHER_ENABLED=false

# Most characters of a note's text that opening a note (the note endpoint,
# get_note over MCP) returns; a longer note is cut with a "[truncated: ...]"
# marker, so a huge note can't flood an agent's context.
NOTE_MAX_CHARS=20000
